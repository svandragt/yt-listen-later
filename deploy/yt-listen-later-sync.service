[Unit]
Description=yt-listen-later playlist sync
Documentation=https://github.com/svandragt/yt-listen-later
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ytll
Group=ytll
WorkingDirectory=/srv/yt-listen-later
ExecStart=/usr/local/bin/uv run ./yt_listen_later.py sync
# Downloading a long backlog on a small VPS can take a while.
TimeoutStartSec=2h

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/yt-listen-later
Environment=HOME=/srv/yt-listen-later
Environment=XDG_CACHE_HOME=/srv/yt-listen-later/.cache

# Keep the sync from starving a 1-vCPU box while ffmpeg transcodes.
Nice=10
IOSchedulingClass=idle
CPUWeight=20
