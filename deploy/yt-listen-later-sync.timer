[Unit]
Description=Sync the yt-listen-later playlist periodically

[Timer]
# Every 30 minutes, and shortly after boot so a reboot doesn't skip a sync.
OnBootSec=2min
OnUnitActiveSec=30min
# Spread the load so every box running this doesn't hit YouTube on the minute.
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
