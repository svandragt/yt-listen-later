# --- required -------------------------------------------------------------

# The playlist to turn into a podcast. Either a full URL or just the list ID.
# Private/unlisted "Watch later"-style playlists need cookies (see below).
YOUTUBE_PLAYLIST_URL=https://www.youtube.com/playlist?list=PLxxxxxxxxxxxxxxxxxx

# Public base URL where this feed is reachable, no trailing slash.
# Overcast fetches the feed and the audio from here, so it must be reachable
# from the internet — a tunnel (tailscale funnel, cloudflared, ngrok) or a
# reverse proxy in front of `serve` both work.
BASE_URL=https://listen.example.com

# --- optional -------------------------------------------------------------

# Where the feed, cover art and audio files are written.
PUBLIC_DIR=public
MEDIA_SUBDIR=media
FEED_NAME=feed.xml

# Feed metadata. Blank values fall back to the playlist's own title/uploader.
FEED_TITLE=
FEED_AUTHOR=
FEED_DESCRIPTION=
FEED_LINK=
FEED_LANGUAGE=en
FEED_CATEGORY=Technology
FEED_EXPLICIT=false

# Newest N playlist entries to keep. 0 means the whole playlist.
MAX_EPISODES=50

# Hard cap on the size of the media directory, in MiB. 0 disables it. Oldest
# episodes are deleted once the cap is passed, and are not re-downloaded
# afterwards. Worth setting on a small VPS: MAX_EPISODES bounds how many
# episodes you keep, this bounds how much disk they take. The newest episode
# is always kept, even if it alone exceeds the cap.
MAX_TOTAL_MB=0

# Audio output. m4a keeps YouTube's native AAC without re-encoding losses;
# mp3 is the most compatible; opus is the smallest, and Overcast plays it.
# AUDIO_QUALITY is passed to yt-dlp (0 = best, or a bitrate like 64K).
AUDIO_FORMAT=m4a
AUDIO_QUALITY=0

# Delete downloaded audio once a video leaves the playlist.
PRUNE_REMOVED=true

# HTTP server for `serve` / `run`.
HOST=0.0.0.0
PORT=8000

# `run` re-syncs on this interval. 0 disables the background refresh.
REFRESH_MINUTES=60

# For private playlists / age-gated videos, pick one:
#   COOKIES_FROM_BROWSER=firefox     (chrome, brave, safari, edge, ...)
#   COOKIE_FILE=/path/to/cookies.txt (Netscape format export)
COOKIES_FROM_BROWSER=
COOKIE_FILE=
